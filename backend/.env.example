# Farmo Backend Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./farmo.db

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Demo Mode (set to true for hackathon demo)
DEMO_MODE=false
DEMO_OTP=123456
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# 2Factor.in SMS OTP
# Sign up at: https://2factor.in/v3/signup/
# Get your API key from: https://2factor.in dashboard → API & SDKs
# DLT template is optional; leave blank to use account default
TWOFACTOR_API_KEY=5955b083-b563-11f1-af74-0200cd936042
TWOFACTOR_SMS_TEMPLATE=OTP

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# MapTiler Cloud Geocoding
# Get a key at: https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=bB0ykUctxeKDzBi6f6iX

# Weather API (OpenWeatherMap - free tier available)
# Sign up at:https://api.weatherapi.com/v1
WEATHER_API_KEY=

# Transport Cost Configuration
TRANSPORT_RATE_PER_KM=15.0
TRANSPORT_MIN_COST=50.0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Voice Providers
STT_PROVIDER=groq
TTS_PROVIDER=gemini

# Groq — Speech to Text
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Gemini — AI + Text to Speech
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

STT_LANGUAGE=hi
