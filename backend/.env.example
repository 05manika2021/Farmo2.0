# Farmo Backend Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./farmo.db

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Demo Mode (set to true for hackathon demo)
DEMO_MODE=true
DEMO_OTP=123456
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# 2Factor.in SMS OTP (classic GET API — SMS channel)
# Sign up at: https://2factor.in/v3/signup/
# Get your API key from: https://2factor.in dashboard → API & SDKs
# Uses: GET /API/V1/{key}/SMS/{phone}/{otp}/{template}
#       GET /API/V1/{key}/SMS/VERIFY/{session_id}/{otp}
# DLT template is optional; leave blank to use account default
TWOFACTOR_API_KEY=
TWOFACTOR_SMS_TEMPLATE=OTP

# Gemini AI (chat + text-to-speech)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Google Maps / Geocoding (fallback provider)
GOOGLE_MAPS_API_KEY=

# MapTiler Cloud Geocoding (primary provider)
# Sign up at: https://cloud.maptiler.com/ → Account → Keys
# Keep this key server-side only (never expose via NEXT_PUBLIC_*)
MAPTILER_API_KEY=

# Weather API (OpenWeatherMap - free tier available)
# Sign up at: https://openweathermap.org/api
WEATHER_API_KEY=

# Transport Cost Configuration
TRANSPORT_RATE_PER_KM=15.0
TRANSPORT_MIN_COST=50.0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Voice Providers
# STT: groq (Groq Whisper) or openai; TTS: gemini (Gemini TTS) or openai
STT_PROVIDER=groq
TTS_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
STT_LANGUAGE=hi

# Groq Whisper (speech-to-text)
# Sign up at: https://console.groq.com/ -> API Keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Chat LLM provider
# LLM_PROVIDER: "groq" | "gemini" | "" (auto)
#   auto -> groq when GROQ_API_KEY is set, otherwise gemini
# GROQ_MODEL: Groq chat-completions model id
# The key stays server-side only (never expose via NEXT_PUBLIC_*)
LLM_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
